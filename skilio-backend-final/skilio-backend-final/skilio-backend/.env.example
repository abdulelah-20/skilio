# ── Skilio Environment Variables ──────────────────────────────────────────────
# Copy this file to .env — the app works WITHOUT a .env file (uses SQLite).
# Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (DEFAULT — zero config, works out of the box):
DATABASE_URL=sqlite:///./skilio.db

# MySQL (uncomment for +5 bonus marks — install pymysql first):
# DATABASE_URL=mysql+pymysql://skilio:skiliopass@localhost:3306/skilio_db

# PostgreSQL (alternative production database):
# DATABASE_URL=postgresql://skilio:skiliopass@localhost:5432/skilio_db

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
# The default dev key works locally — CHANGE before any real deployment.
SECRET_KEY=skilio-dev-secret-key-change-before-production-deploy-now

# ── JWT Token Expiry ──────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false

# ── Docker Compose (MySQL only) ───────────────────────────────────────────────
# MYSQL_ROOT_PASSWORD=rootpassword
# MYSQL_PASSWORD=skiliopass
